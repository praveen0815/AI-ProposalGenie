# Local development values for Docker Compose and the FastAPI app.
# Copy this file to .env before starting the stack. Change the passwords
# before using this project anywhere other than your own machine.
# The application does not contain these credentials; it reads them here.

APP_NAME=ProposalGenie
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=proposalgenie
POSTGRES_PASSWORD=pg_dev_change_me
POSTGRES_DB=proposalgenie

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_change_me
REDIS_DB=0

# Optional overrides. When set, the API uses these URLs instead of the
# host, port, user, and password values above.
# DATABASE_URL=postgresql+psycopg://proposalgenie:pg_dev_change_me@localhost:5432/proposalgenie
# REDIS_URL=redis://:redis_dev_change_me@localhost:6379/0

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Used to sign access tokens. Replace this before sharing the environment.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Per-IP request limits. Tests set RATE_LIMIT_ENABLED=false.
# Auth covers register and login. Expensive covers generation, agents, RAG, and export.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_READ_PER_MINUTE=300

# Company documents. This path is outside the frontend and is not served publicly.
DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS_PER_COMPANY=100

# Retrieval. Chroma persists under storage/ and is not served by the frontend.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=company_knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25

# OpenAI-compatible generation. Leave the key empty until a provider is configured.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Gemini proposal generation. The React app never receives this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# Multi-agent workflow. External research stays off until both values are set.
AGENT_MAX_REVIEW_ITERATIONS=2
RESEARCH_API_KEY=
RESEARCH_BASE_URL=
