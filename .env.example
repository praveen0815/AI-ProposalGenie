# Local development values for Docker Compose and the FastAPI app.
# Copy this file to .env before starting the stack. Change the passwords
# before using this project anywhere other than your own machine.
# The application does not contain these credentials; it reads them here.

APP_NAME=ProposalGenie
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=proposalgenie
POSTGRES_PASSWORD=pg_dev_change_me
POSTGRES_DB=proposalgenie

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_change_me
REDIS_DB=0

# Optional overrides. When set, the API uses these URLs instead of the
# host, port, user, and password values above.
# DATABASE_URL=postgresql+psycopg://proposalgenie:pg_dev_change_me@localhost:5432/proposalgenie
# REDIS_URL=redis://:redis_dev_change_me@localhost:6379/0

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Used to sign access tokens. Replace this before sharing the environment.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Company documents. This path is outside the frontend and is not served publicly.
DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS_PER_COMPANY=100
